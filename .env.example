# =============================================================================
# DEVHUB Environment Variables
# Copy this file to .env and fill in the values
# =============================================================================

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:password@localhost:5432/devhub?schema=public"

# Auth.js / NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-a-long-random-string-here

# OAuth Providers (optional – leave empty to disable)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Redis (optional – for caching & rate limiting)
REDIS_URL=redis://localhost:6379

# File Storage (S3-compatible)
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=devhub
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# Email (for verification & password reset)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="DEVHUB <noreply@devhub.dev>"
